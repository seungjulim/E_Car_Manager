# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 git 에 올리지 않는다)

# --- Neon (Postgres) ---
# Neon 콘솔 > Connection Details 의 연결 문자열 (pooled 권장)
DATABASE_URL=

# --- Clerk (로그인·가족=Organization) ---
# Clerk 대시보드 > API Keys. 대시보드에서 Organizations 기능을 켜야 가족 기능이 동작한다.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Vercel Blob (신차·수리내역서 이미지) ---
BLOB_READ_WRITE_TOKEN=

# --- Claude API (번역·요약·분류·비전) ---
ANTHROPIC_API_KEY=

# --- 알림 (추후) ---
# Vercel Cron 호출 검증용 비밀 값
CRON_SECRET=
# Web Push(VAPID) 키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알려 줄 연락처. 본인 메일로 바꿔 쓴다(예: mailto:me@example.com)
VAPID_SUBJECT=mailto:you@example.com

# --- 노션 저장 (선택) ---
# 노션 내부 통합의 토큰, 그리고 저장 결과를 모아 둘 상위 페이지의 주소(또는 id). 상위 페이지에 통합을 '연결'해 둬야 한다.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
